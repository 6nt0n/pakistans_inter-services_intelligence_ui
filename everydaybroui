			sv.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
			svCursor.Position = UDim2.fromOffset(PAD + S * SV_W, PAD + (1 - V) * SV_H)
			hueCursor.Position = UDim2.fromOffset(HUE_X + HUE_W / 2, PAD + H * SV_H)
	
			local r = math.floor(currentColor.R * 255 + 0.5)
			local g = math.floor(currentColor.G * 255 + 0.5)
			local b = math.floor(currentColor.B * 255 + 0.5)
			if not rBox:IsFocused() then rBox.Text = tostring(r) end
			if not gBox:IsFocused() then gBox.Text = tostring(g) end
			if not bBox:IsFocused() then bBox.Text = tostring(b) end
			if not hexBox:IsFocused() then hexBox.Text = string.format("#%02X%02X%02X", r, g, b) end
	
			if onChanged and not skipCallback then
				onChanged(currentColor)
			end
		end
	
		local function applyColor(color)
			local h, s, v = Color3.toHSV(color)
			if s > 0 and v > 0 then
				H = h -- keep the hue when the color is grey or black
			end
			S, V = s, v
			update(false)
		end
	
		local function setSV(point)
			local pos, size = sv.AbsolutePosition, sv.AbsoluteSize
			S = math.clamp((point.X - pos.X) / size.X, 0, 1)
			V = 1 - math.clamp((point.Y - pos.Y) / size.Y, 0, 1)
			update(false)
		end
	
		local function setHue(point)
			local pos, size = hue.AbsolutePosition, hue.AbsoluteSize
			H = math.clamp((point.Y - pos.Y) / size.Y, 0, 1)
			update(false)
		end
	
		local function setFromRGBBoxes()
			local r = math.clamp(math.floor((tonumber(rBox.Text) or 0) + 0.5), 0, 255)
			local g = math.clamp(math.floor((tonumber(gBox.Text) or 0) + 0.5), 0, 255)
			local b = math.clamp(math.floor((tonumber(bBox.Text) or 0) + 0.5), 0, 255)
			applyColor(Color3.fromRGB(r, g, b))
		end
	
		local function setFromHexBox()
			local parsed = ColorFromHex(hexBox.Text)
			if parsed then
				applyColor(parsed)
			else
				update(true) -- bad input, put the real value back
			end
		end
	
		-- public api
		local picker = {}
		function picker:SetOpen(state)
			open = state and true or false
			if open then
				if Library.ActiveFloatingColorPicker and Library.ActiveFloatingColorPicker ~= picker then
					Library.ActiveFloatingColorPicker:SetOpen(false)
				end
				Library.ActiveFloatingColorPicker = picker
				positionPopup()
				popup.Visible = true
			else
				popup.Visible = false
				draggingSV = false
				draggingHue = false
				if Library.ActiveFloatingColorPicker == picker then
					Library.ActiveFloatingColorPicker = nil
				end
			end
		end
		function picker:Toggle()
			picker:SetOpen(not open)
		end
		function picker:IsOpen()
			return open
		end
		function picker:Set(value)
			local newColor = typeof(value) == "Color3" and value or ColorFromHex(value)
			if newColor then
				applyColor(newColor)
			end
		end
		function picker:Get()
			return currentColor
		end
	
		-- input
		svHit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSV = true
				setSV(mousePos())
			end
		end)
		hueHit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingHue = true
				setHue(mousePos())
			end
		end)
	
		rBox.FocusLost:Connect(setFromRGBBoxes)
		gBox.FocusLost:Connect(setFromRGBBoxes)
		bBox.FocusLost:Connect(setFromRGBBoxes)
		hexBox.FocusLost:Connect(setFromHexBox)
	
		AddConnection(UIS.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSV = false
				draggingHue = false
			end
		end)
		AddConnection(UIS.InputChanged, function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				if draggingSV then
					setSV(mousePos())
				elseif draggingHue then
					setHue(mousePos())
				end
			end
		end)
		AddConnection(UIS.InputBegan, function(input, gp)
			if gp or not open then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local pos = mousePos()
				if not pointInside(popup, pos) and not pointInside(anchor, pos) then
					picker:SetOpen(false)
				end
			end
		end)
	
		-- follow the swatch if the window gets dragged or scrolled
		anchor:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
			if open then
				positionPopup()
			end
		end)
	
		update(true)
		return picker
	end


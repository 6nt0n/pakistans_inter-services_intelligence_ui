					local function isPointInsideSwatch(pos)
						local ap, as = swatch.AbsolutePosition, swatch.AbsoluteSize
						return pos.X >= ap.X and pos.X <= ap.X + as.X and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y

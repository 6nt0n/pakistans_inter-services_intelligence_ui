	local function LoadGithubImage(url)
		if type(url) ~= "string" or not url:match("^https?://") then
			return url
		end

		url = url:gsub(
			"https://github%.com/([^/]+/[^/]+)/blob/([^/]+)/(.+)",
			"https://raw.githubusercontent.com/%1/%2/%3"
		)

		local filename = "junt_ui/github_logo.png"

		local success, data = pcall(function()
			return game:HttpGet(url)
		end)

		if not success or type(data) ~= "string" or #data == 0 then
			warn("junt_ui: failed to download image: " .. url)
			return nil
		end

		if writefile then
			pcall(function()
				if makefolder and (not isfolder or not isfolder("junt_ui")) then
					makefolder("junt_ui")
				end
				writefile(filename, data)
			end)
		end

		if getcustomasset then
			local ok, asset = pcall(function()
				return getcustomasset(filename)
			end)
			if ok then
				return asset
			end
		end

		if getsynasset then
			local ok, asset = pcall(function()
				return getsynasset(filename)
			end)
			if ok then
				return asset
			end
		end

		return nil
	end


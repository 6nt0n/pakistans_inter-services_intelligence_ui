local function AddConnection(signal, callback)
	local c = signal:Connect(callback)
	table.insert(Library.Connections, c)
	return c
end

local function New(class, props)
	local obj = Instance.new(class)
	if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
		obj.Font = Library.Font
		obj.TextSize = Library.TextSize
	end
	for k, v in pairs(props or {}) do
		obj[k] = v
	end
	return obj
end

local function Tween(obj, props, time)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(time or 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function TextWidth(text, size)
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(tostring(text), size or Library.TextSize, Library.Font, Vector2.new(10000, 1000))
	end)
	if ok and bounds then
		return bounds.X
	end
	return #tostring(text) * 6
end

function Library:Notify(data, duration)
	local title = "Notification"
	local message = ""
	local time = duration or 3
	if typeof(data) == "table" then
		title = tostring(data.Title or data.title or data.Name or data.name or title)
		message = tostring(data.Text or data.text or data.Message or data.message or "")
		time = tonumber(data.Duration or data.duration or data.Time or data.time) or time
	else
		message = tostring(data or "")
	end
	time = math.max(tonumber(time) or 3, 0.2)

	if not self.NotificationGui or not self.NotificationGui.Parent then
		local notifyGui = New("ScreenGui", {
			Name = "junt_notifications",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			ZIndexBehavior = Enum.ZIndexBehavior.Global,
			DisplayOrder = 1000,
			Parent = PlayerGui
		})
		local holder = New("Frame", {
			Parent = notifyGui,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 12),
			Size = UDim2.fromOffset(230, 0),
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y
		})
		New("UIListLayout", {
			Parent = holder,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Right
		})
		self.NotificationGui = notifyGui
		self.NotificationHolder = holder
	end

	local notification = New("Frame", {
		Parent = self.NotificationHolder,
		Size = UDim2.fromOffset(230, 46),
		BackgroundColor3 = self.Theme.Section,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true
	})
	local nStroke = New("UIStroke", {
		Parent = notification,
		Color = self.Theme.Border,
		Thickness = 1,
		Transparency = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	})

	-- thin accent edge on the left (stops above the loading bar)
	local edge = New("Frame", {
		Parent = notification,
		Size = UDim2.new(0, 2, 1, -3),
		BackgroundColor3 = self.Theme.Accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0
	})

	local titleLabel = New("TextLabel", {
		Parent = notification,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 5),
		Size = UDim2.new(1, -16, 0, 14),
		Text = title,
		TextColor3 = self.Theme.Text,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd
	})
	local messageLabel = New("TextLabel", {
		Parent = notification,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 21),
		Size = UDim2.new(1, -16, 0, 14),
		Text = message,
		TextColor3 = self.Theme.Dim,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd
	})

	-- loading bar along the bottom edge
	local track = New("Frame", {
		Parent = notification,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = self.Theme.Bg,
		BackgroundTransparency = 1,
		BorderSizePixel = 0
	})
	local fill = New("Frame", {
		Parent = track,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = self.Theme.Accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0
	})

	local scale = New("UIScale", {Parent = notification, Scale = 0.96})
	local function fade(a)
		Tween(notification, {BackgroundTransparency = a}, 0.12)
		Tween(nStroke, {Transparency = a}, 0.12)
		Tween(edge, {BackgroundTransparency = a}, 0.12)
		Tween(titleLabel, {TextTransparency = a}, 0.12)
		Tween(messageLabel, {TextTransparency = a}, 0.12)
		Tween(track, {BackgroundTransparency = a}, 0.12)
		Tween(fill, {BackgroundTransparency = a}, 0.12)
	end

	local progress = TweenService:Create(
		fill,
		TweenInfo.new(time, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{Size = UDim2.fromScale(0, 1)}
	)

	local closed = false
	local function close()
		if closed then return end
		closed = true
		progress:Cancel()
		Tween(scale, {Scale = 0.96}, 0.12)
		fade(1)
		task.delay(0.13, function()
			if notification and notification.Parent then
				notification:Destroy()
			end
		end)
	end

	fade(0)
	Tween(scale, {Scale = 1}, 0.12)

	-- bar drains from full to empty, the notification closes the moment it hits zero
	progress.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed then
			close()
		end
	end)
	progress:Play()

	return {Close = close, Instance = notification}
end

